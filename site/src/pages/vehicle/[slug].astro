---
import VehiclePage from "../../components/VehiclePage.astro";
import { MODELS, vehiclePaths } from "../../lib/trucks";

export function getStaticPaths() {
  return vehiclePaths(MODELS.datsun);
}
const { listing, all } = Astro.props;
---

<VehiclePage listing={listing} all={all} model={MODELS.datsun} />
