---
// Listings front page for one truck (Datsun 620 at /, Hilux at /hilux/).
import Base from "../layouts/Base.astro";
import ListingCard from "./ListingCard.astro";
import { type TruckModel, countryName, isTarget, loadListings, sourceName } from "../lib/trucks";

interface Props {
  model: TruckModel;
}
const { model } = Astro.props;
const hilux = model.key === "hilux";
const { listings, generated } = loadListings(model);

const active = listings.filter((l) => l.status === "active");
const ended = listings.filter((l) => l.status !== "active");
const countries = [...new Set(listings.map((l) => l.country))].sort();
const nTarget = active.filter(isTarget).length;
// Hilux: trucks like the owner's RN30 lead by default.
const byTargetFirst = (a: any, b: any) => Number(isTarget(b)) - Number(isTarget(a));
if (hilux) active.sort(byTargetFirst);
---

<Base title={model.siteTitle}>
  <h1>Listings</h1>
  {
    listings.length === 0 ? (
      <p>{model.emptyListings}</p>
    ) : (
      <>
        <p class="supporting">
          {model.listingsIntro}
          {" "}{active.length} active, {ended.length} ended.
          {hilux && nTarget > 0 && <> <b class="target-count">{nTarget} {nTarget === 1 ? "matches" : "match"} your RN30 spec.</b></>}
          {" "}Updated {generated}.
        </p>
        <form class="filters" id="filters" data-default-sort={hilux ? "match" : undefined}>
          {hilux && (
            <select class="fchip" name="match" aria-label="RN30 match">
              <option value="">All trucks</option>
              <option value="target">RN30 matches only</option>
            </select>
          )}
          <select class="fchip" name="country" aria-label="Country">
            <option value="">All countries</option>
            {countries.map((c) => (
              <option value={c}>{countryName(c)}</option>
            ))}
          </select>
          <select class="fchip" name="body" aria-label="Body style">
            <option value="">All bodies</option>
            <option value="kc">{model.extLabel}</option>
            <option value="other">Unconfirmed / other</option>
          </select>
          {hilux && (
            <select class="fchip" name="wd" aria-label="2WD or 4WD">
              <option value="">2WD + 4WD</option>
              <option value="2WD">2WD</option>
              <option value="4WD">4WD</option>
              <option value="unknown">not stated</option>
            </select>
          )}
          <select class="fchip" name="drive" aria-label="Drive side">
            <option value="">LHD + RHD</option>
            <option value="LHD">LHD</option>
            <option value="RHD">RHD</option>
            <option value="unknown">unknown</option>
          </select>
          <select class="fchip" name="yearmin" aria-label="Year from">
            <option value="">Year from</option>
            {model.listingYears.map((y) => (
              <option value={y}>{y}</option>
            ))}
          </select>
          <select class="fchip" name="yearmax" aria-label="Year to">
            <option value="">Year to</option>
            {model.listingYears.map((y) => (
              <option value={y}>{y}</option>
            ))}
          </select>
          <input class="fchip" type="number" name="pricemax" inputmode="numeric" placeholder="Max £" aria-label="Maximum price in GBP" />
          <select class="fchip" name="source" aria-label="Source">
            <option value="">All sources</option>
            {[...new Set(listings.map((l) => l.source))].sort().map((src) => (
              <option value={src}>{sourceName(src)}</option>
            ))}
          </select>
          <select class="fchip" name="sort" aria-label="Sort order">
            {hilux ? (
              <>
                <option value="">Best match first</option>
                <option value="newest">Newest first</option>
              </>
            ) : (
              <option value="">Newest first</option>
            )}
            <option value="price-asc">Price: low to high</option>
            <option value="price-desc">Price: high to low</option>
          </select>
        </form>
        <p class="count supporting" id="filter-count" aria-live="polite"></p>
        {active.length > 0 && <h2 class="section">Active</h2>}
        <div class="cards">
        {active.map((l) => <ListingCard l={l} model={model} />)}
        </div>
        {ended.length > 0 && <h2 class="section">Recently ended</h2>}
        <div class="cards">
        {ended.map((l) => <ListingCard l={l} model={model} ended />)}
        </div>
        <script>
          const form = document.getElementById("filters") as HTMLFormElement | null;
          const cards = Array.from(document.querySelectorAll("article.listing")) as HTMLElement[];
          const count = document.getElementById("filter-count");

          // Filters live in the URL so state survives back-navigation and
          // filtered views can be bookmarked or shared.
          function loadFromUrl() {
            if (!form) return;
            const params = new URLSearchParams(location.search);
            for (const el of form.querySelectorAll("select, input")) {
              const input = el as HTMLInputElement;
              if (params.has(input.name)) input.value = params.get(input.name) ?? "";
            }
          }
          function saveToUrl() {
            if (!form) return;
            const params = new URLSearchParams();
            for (const el of form.querySelectorAll("select, input")) {
              const input = el as HTMLInputElement;
              if (input.value) params.set(input.name, input.value);
            }
            const qs = params.toString();
            history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
          }

          function apply() {
            if (!form) return;
            const data = new FormData(form);
            const country = data.get("country") as string;
            const body = data.get("body") as string;
            const drive = data.get("drive") as string;
            const source = data.get("source") as string;
            const sort = data.get("sort") as string;
            // Hilux-only controls; absent (null) on the Datsun page.
            const match = (data.get("match") as string) ?? "";
            const wd = (data.get("wd") as string) ?? "";
            const matchFirst = form.dataset.defaultSort === "match" && !sort;
            const ymin = Number(data.get("yearmin")) || 0;
            const ymax = Number(data.get("yearmax")) || 9999;
            // "0" must apply as a real ceiling, not fall back to Infinity.
            const rawPmax = (data.get("pricemax") as string) ?? "";
            const pmax = rawPmax !== "" && !isNaN(Number(rawPmax)) ? Number(rawPmax) : Infinity;
            const yearBound = Boolean(data.get("yearmin") || data.get("yearmax"));
            const priceBound = pmax !== Infinity;
            let shown = 0;
            for (const el of cards) {
              const year = Number(el.dataset.year) || null;
              const gbp = Number(el.dataset.gbp) || null;
              // A listing with an unknown year/price is hidden when that
              // filter is in use: "max £5000" must not surface no-price cards.
              const ok =
                (!country || el.dataset.country === country) &&
                (!body || (body === "kc" ? el.dataset.kc === "1" : el.dataset.kc !== "1")) &&
                (!drive || el.dataset.drive === drive) &&
                (!source || el.dataset.source === source) &&
                (!match || el.dataset.target === "1") &&
                (!wd || el.dataset.wd === wd) &&
                (year === null ? !yearBound : year >= ymin && year <= ymax) &&
                (gbp === null ? !priceBound : gbp <= pmax);
              el.style.display = ok ? "" : "none";
              if (ok) shown++;
            }
            // Sort within each section container; unknown prices sink to the end.
            for (const box of document.querySelectorAll("div.cards")) {
              const kids = Array.from(box.querySelectorAll("article.listing")) as HTMLElement[];
              kids.sort((a, b) => {
                if (sort === "price-asc" || sort === "price-desc") {
                  const pa = Number(a.dataset.gbp) || null;
                  const pb = Number(b.dataset.gbp) || null;
                  if (pa === null && pb !== null) return 1; // unknown price sinks
                  if (pb === null && pa !== null) return -1;
                  if (pa !== null && pb !== null && pa !== pb) {
                    return sort === "price-asc" ? pa - pb : pb - pa;
                  }
                }
                // Hilux default: trucks matching the owner's RN30 spec lead.
                if (matchFirst) {
                  const ta = a.dataset.target === "1" ? 1 : 0;
                  const tb = b.dataset.target === "1" ? 1 : 0;
                  if (ta !== tb) return tb - ta;
                }
                // "Newest first" means listing date for active cards and END
                // date for ended ones.
                const ka = a.dataset.ended || a.dataset.seen || "";
                const kb = b.dataset.ended || b.dataset.seen || "";
                return kb.localeCompare(ka);
              });
              for (const k of kids) box.appendChild(k);
            }
            if (count) count.textContent = `showing ${shown} of ${cards.length}`;
            for (const el of form.querySelectorAll("select, input")) {
              (el as HTMLElement).classList.toggle("fchip-active", Boolean((el as HTMLInputElement).value));
            }
            // Hide a section heading when everything under it is filtered out.
            for (const h2 of document.querySelectorAll("main h2.section")) {
              const box = h2.nextElementSibling;
              const any = box && Array.from(box.querySelectorAll("article.listing"))
                .some((c) => (c as HTMLElement).style.display !== "none");
              (h2 as HTMLElement).style.display = any ? "" : "none";
            }
            saveToUrl();
          }
          form?.addEventListener("input", apply);
          loadFromUrl();
          apply();
        </script>
      </>
    )
  }
  <style>
    .target-count {
      color: var(--primary);
      font-weight: 600;
    }
  </style>
</Base>
