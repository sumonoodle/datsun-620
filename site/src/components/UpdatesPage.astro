---
// Daily changes for one truck (Datsun 620 at /updates/, Hilux at /hilux/updates/).
import Base from "../layouts/Base.astro";
import {
  type TruckModel, base, chassisCode, driveTrain, gbp, isTarget, money,
  readJsonPath, readModelJson, sourceName, vehicleHref,
} from "../lib/trucks";

interface Props {
  model: TruckModel;
}
const { model } = Astro.props;
const hilux = model.key === "hilux";

// Each file is read independently: any Hilux file may be missing before its
// pipeline first runs, and a missing run log must not hide the changes.
const changes: any = readModelJson(model, "changes-latest.json");
const runLog: any = changes ? readModelJson(model, "run-log.json") : null;
const listings: any[] = changes ? readModelJson(model, "listings.json")?.listings ?? [] : [];
const listingsById: Record<string, any> = Object.fromEntries(listings.map((l) => [l.id, l]));
let fxLine = "";
const fx = readJsonPath("../data/fx-rates.json");
try {
  const r = fx.latest.rates;
  fxLine = `FX ${fx.latest.date}: £1 = $${r.USD} / €${r.EUR} / ¥${r.JPY}`;
} catch {
  /* optional */
}

const href = (id: string) => vehicleHref(model, id);

const relistIds = new Set((changes?.possible_relists ?? []).map((r: any) => r.id));
const newListings = (changes?.new ?? [])
  .filter((id: string) => !relistIds.has(id))
  .map((id: string) => listingsById[id])
  .filter(Boolean);
// Hilux: trucks like the owner's RN30 lead the section.
if (hilux) newListings.sort((a: any, b: any) => Number(isTarget(b)) - Number(isTarget(a)));
const priceChanges = (changes?.price_changed ?? []).filter((c: any) => listingsById[c.id]);
const statusChanges = (changes?.status_changed ?? []).filter((c: any) => listingsById[c.id]);
const relists = (changes?.possible_relists ?? []).filter((r: any) => listingsById[r.id]);
const quiet = !newListings.length && !priceChanges.length && !statusChanges.length && !relists.length;
const t = runLog?.totals;
const started = (runLog?.started_at ?? "").slice(11, 16);
const variantBits = (l: any) => [chassisCode(l), driveTrain(l)].filter(Boolean).map((x) => ` · ${x}`).join("");
---

<Base title={`Updates — ${model.siteTitle}`}>
  <h1>Updates</h1>
  {
    !changes ? (
      <p>No run data yet. The first daily sweep populates this page.</p>
    ) : (
      <>
        <p class="supporting">Daily sweep for {changes.date}.{started && ` Run started ${started} UTC.`}</p>

        {quiet && (
          <div class="card quiet">
            <p>No new or changed listings today. The sweep ran and found the market unchanged.</p>
          </div>
        )}

        {newListings.length > 0 && <h2>New listings ({newListings.length})</h2>}
        {newListings.map((l: Listing) => (
          <a class:list={["card elevated row", { target: isTarget(l) }]} href={href(l.id)}>
            {l.images[0] && <img src={l.images[0]} alt="" width="96" height="72" loading="lazy" onerror="this.style.display='none'" />}
            <span class="row-txt">
              {isTarget(l) && <span class="target-line">★ {model.targetLabel}</span>}
              <b>{l.king_cab?.matched && <span class="chip chip-primary kc-chip">{model.extChip}</span>}{l.title_translated ?? l.title}</b>
              <span class="supporting">{money(l.price)} · {l.country} · {l.drive_side}{variantBits(l)}</span>
            </span>
          </a>
        ))}

        {priceChanges.length > 0 && <h2>Price changes ({priceChanges.length})</h2>}
        {priceChanges.map((c: any) => {
          const l = listingsById[c.id];
          const drop = (c.pct ?? 0) < 0;
          return (
            <a class="card elevated row" href={href(c.id)}>
              {l.images[0] && <img src={l.images[0]} alt="" width="96" height="72" loading="lazy" onerror="this.style.display='none'" />}
              <span class="row-txt">
                <b>{l.title_translated ?? l.title}</b>
                <span class="supporting">
                  {gbp(c.old_gbp)} → <b>{gbp(c.new_gbp)}</b>
                  {c.pct != null && (
                    <span class={drop ? "delta-down" : "delta-up"}> {drop ? "▼" : "▲"} {Math.abs(c.pct).toFixed(0)}%</span>
                  )}
                </span>
              </span>
            </a>
          );
        })}

        {relists.length > 0 && <h2>Possible relists ({relists.length})</h2>}
        {relists.map((r: any) => {
          const l = listingsById[r.id];
          return (
            <a class="card elevated row" href={href(r.id)}>
              {l.images[0] && <img src={l.images[0]} alt="" width="96" height="72" loading="lazy" onerror="this.style.display='none'" />}
              <span class="row-txt">
                <b>{l.title_translated ?? l.title}</b>
                <span class="supporting">Possible relist (not certain): {r.reasons.join("; ")}</span>
              </span>
            </a>
          );
        })}

        {statusChanges.length > 0 && <h2>Status changes ({statusChanges.length})</h2>}
        {statusChanges.map((c: any) => {
          const l = listingsById[c.id];
          return (
            <a class="card elevated row" href={href(c.id)}>
              {l.images[0] && <img src={l.images[0]} alt="" width="96" height="72" loading="lazy" onerror="this.style.display='none'" />}
              <span class="row-txt">
                <b>{l.title_translated ?? l.title}</b>
                <span class="supporting">{c.old_status} → <b>{c.new_status}</b></span>
              </span>
            </a>
          );
        })}

        {runLog?.sources?.length > 0 && (
          <>
            <h2>Source health</h2>
            <ul class="card health">
              {runLog.sources.map((s: any) => (
                <li>
                  <span class={`dot ${s.ok ? "dot-ok" : s.expected_blocked ? "dot-known" : "dot-bad"}`} /> {sourceName(s.source)}
                  {s.ok
                    ? <span class="supporting"> — {s.records} listing(s)
                        {/* A source can be "ok" and still be blind: eBay
                            reported ok/0 for a month. Show the quiet streak
                            so a long silence is visible here too. */}
                        {s.consecutive_zero_runs >= 5 && ` (quiet ${s.consecutive_zero_runs} days)`}</span>
                    : s.expected_blocked
                      ? /* Blocked by design, not broken by accident: an IP-level
                           ban whose route is the email alerts. Muted, because a
                           red dot that never changes stops being read. */
                        <span class="supporting"> — blocked {s.consecutive_failures} days (known, awaiting email alerts)</span>
                      : <span class="supporting"> — {s.note}{s.consecutive_failures > 1 && ` (${s.consecutive_failures} days)`}</span>}
                </li>
              ))}
            </ul>
          </>
        )}

        {t && (
          <p class="supporting stats">
            Active: <b>{t.active}</b>
            {t.median_gbp != null && <> · median {gbp(t.median_gbp)}</>}
            {fxLine && <><br />{fxLine}</>}
          </p>
        )}
        <p class="email-link">
          <a class="btn-text" href={`${base}/digest.html`}>Email preview →</a>
        </p>
      </>
    )
  }
  <style>
    .quiet {
      padding: 0.5rem 1rem;
      color: var(--on-surface-variant);
    }
    .row {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      padding: 0.7rem 0.85rem;
      margin: 0.6rem 0;
      text-decoration: none;
      color: var(--on-surface);
    }
    .row img {
      border-radius: 10px;
      object-fit: cover;
      flex: none;
    }
    .row-txt {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      min-width: 0;
    }
    .kc-chip {
      font-size: 0.68rem;
      margin-right: 0.4rem;
      vertical-align: middle;
      padding: 0.1rem 0.5rem;
    }
    .target-line {
      color: var(--primary);
      font-weight: 600;
      font-size: 0.8rem;
    }
    .row.target {
      outline: 2px solid var(--primary);
    }
    .row-txt b {
      font-weight: 500;
      font-size: 0.95rem;
    }
    .row-txt .supporting {
      font-size: 0.83rem;
    }
    .delta-down {
      color: var(--tertiary);
      font-weight: 500;
    }
    .delta-up {
      color: var(--error);
      font-weight: 500;
    }
    .health {
      list-style: none;
      margin: 0;
      padding: 0.85rem 1rem;
      font-size: 0.9rem;
    }
    .health li {
      margin: 0.45rem 0;
    }
    .dot {
      display: inline-block;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      margin-right: 0.45rem;
    }
    .dot-known { background: #b9a88f; }
    .dot-ok {
      background: var(--tertiary);
    }
    .dot-bad {
      background: var(--error);
    }
    .stats {
      text-align: center;
      font-size: 0.85rem;
      margin-top: 1.5rem;
    }
    .email-link {
      text-align: center;
      margin: 0.5rem 0 0;
    }
  </style>
</Base>
